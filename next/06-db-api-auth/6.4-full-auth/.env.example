MONGODB_URI=mongodb://127.0.0.1:27017/full-auth
# נוצר עם: npx auth secret   (או: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-random-secret
# מה-OAuth App ב-GitHub (ראו README)
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# נדרש ב-next start מחוץ ל-Vercel
AUTH_TRUST_HOST=true
